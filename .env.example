# Local development template. Copy to .env.local and fill in.
# Production does NOT use .env files: the instance pulls everything under
# /italian-shoes/ from SSM Parameter Store at service start.

DATABASE_URL="postgresql://user:password@localhost:5432/italian_shoes"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 48"

# S3 asset storage. No static keys here — the AWS SDK uses the default
# credential chain (locally: `aws configure` or standard AWS_* env vars;
# in production: the EC2 instance role).
S3_REGION="us-east-1"
S3_BUCKET_NAME="italian-shoes-color"

# Public CDN base for assets — inlined into the client bundle at build time.
NEXT_PUBLIC_CLOUDFRONT_URL=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

RESEND_API_KEY=""

MAX_FILE_SIZE_MB="50"

# Used only by `npm run db:seed`. Without ADMIN_PASSWORD the seed falls
# back to a known default — never let that happen outside local dev.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
